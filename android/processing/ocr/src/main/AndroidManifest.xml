<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ML Kit's bundled text recognition runs on the device, but its Google telemetry dependency
        (com.google.android.datatransport) asks for network access. Sakshi must not have any, so both
        permissions are removed for every APK that includes this module. Without INTERNET the
        process cannot open sockets, so nothing can be sent.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Optional notification observation lane (megaplan 13.2). The service is disabled until the person makes an
        affirmative choice in the app, which calls NotificationObservation.enable() and so switches the component on at
        runtime. A build that never enables the lane exposes nothing: a disabled service is not listed in the system
        notification access screen and cannot be bound. The service is exported only because the system must bind it;
        the bind permission limits binding to the system.
    -->
    <application>
        <service
            android:name="org.sakshi.acquisition.notifications.SakshiNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!--
                No filter-type meta-data (android.service.notification.default_filter_types, API 31+) is declared.
                The meta-data names are verified in the platform jar, but the accepted value tokens could not be
                verified locally. An absent default means all notification types, which is wanted here because
                silent messages can be relevant. The person can still narrow this in system settings.
            -->
        </service>
    </application>
</manifest>
